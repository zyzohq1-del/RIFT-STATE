# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# 1) إعدادات الربط وملفات السيرفر (FiveM & Site API)
SITE_API_URL="https://example.com/api"
FIVEM_API_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
SESSION_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"

# 2) إعدادات الديسكورد والرتب (Discord OAuth & Roles)
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_GUILD_ID="YOUR_DISCORD_GUILD_ID"
DISCORD_OWNER_ROLE_ID="YOUR_DISCORD_OWNER_ROLE_ID"
DISCORD_APPROVED_ROLE_ID="YOUR_APPROVED_ROLE_ID"
# Optional comma-separated role IDs; production OAuth requires at least one matching role when set
DISCORD_REQUIRED_ROLE_IDS="YOUR_APPROVED_ROLE_ID"
DISCORD_REJECTED_ROLE_ID="123456789088888888"
# Discord Redirect URI (اتركه فارغاً ليتم تحديده تلقائياً من رابط الموقع أو ضع رابط موقعك متبوعاً بـ /auth/discord/callback)
DISCORD_REDIRECT_URI="https://ais-pre-2yikl3z2po224ybxu47lot-409567795837.europe-west2.run.app/auth/discord/callback"
DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN"
WHITELIST_ROLE_ID="YOUR_WHITELIST_ROLE_ID"

# 3) إعدادات البث المباشر (Twitch EventSub)
TWITCH_CLIENT_ID="YOUR_TWITCH_CLIENT_ID"
TWITCH_CLIENT_SECRET="YOUR_TWITCH_CLIENT_SECRET"
TWITCH_WEBHOOK_SECRET="YOUR_TWITCH_WEBHOOK_SECRET"

# Steam OpenID Return URL (اتركه فارغاً ليتم تحديده تلقائياً أو ضع رابط موقعك متبوعاً بـ /auth/steam/callback)
STEAM_RETURN_URL="https://ais-pre-2yikl3z2po224ybxu47lot-409567795837.europe-west2.run.app/auth/steam/callback"

# Staff & Owner Passkey
OWNER_ROLE_ID="YOUR_DISCORD_OWNER_ROLE_ID"
OWNER_DISCORD_ID="123456789011111111"
OWNER_PASSKEY="GENERATE_A_LONG_RANDOM_PASSKEY"
